train.epochs = 1283
train.batch_size = 256
train.learning_rate = 0.0001
train.weight_decay = 0.01
train.gradient_accumulate_every = 1

train.dataset_folder = "datasets/ebnerd"

train.vae_input_dim = 768
train.vae_hidden_dims = [512]
train.vae_embed_dim = 256

train.vae_num_categories = 25
train.vae_c2_codebook_size = 128
train.vae_c3_codebook_size = 256


train.vae_codebook_normalize = False
train.vae_sim_vq = False
train.vae_codebook_mode = %QuantizeForwardMode.STE

train.lambda_rec = 1.0
train.lambda_cb = 1.0
train.lambda_com = 0.25
train.lambda_uniq = 0.1
train.uniqueness_margin = 0.5

train.kmeans_encode_batch_size = 512
train.kmeans_n_init = 10

train.gumbel_t0 = 1.0
train.gumbel_min_t = 0.1
train.gumbel_anneal_rate = 0.000058

train.split_batches = True
train.amp = True
train.mixed_precision_type = "fp16"
train.num_workers = 0

# 학습 전/후 Train + Validation loss를 모두 출력하려면 True
train.do_eval = True
train.eval_every_epochs = 10

# Early Stopping
# 최대 1283 epoch까지 학습하되, 최소 200 epoch 이후
# Validation Total/Rec 둘 다 20번 연속 의미 있는 개선이 없으면 조기 종료.
train.early_stopping = True
train.early_stopping_min_epochs = 200
train.early_stopping_patience = 20
train.early_stopping_min_delta = 0.001

# Checkpoint
train.pretrained_rqvae_path = None
train.save_dir_root = "out/rqvae/ebnerd/"
train.save_model_every_epochs = 50

# Logging
train.wandb_logging = False
train.wandb_project = "news-rqvae-training"

# Misc
train.seed = 42
